<%- include('layouts/header') %>

<section class="section">
  <h1>Encouragement Wall</h1>
  <p class="section-intro">Leave a message of encouragement for Hannah!</p>

  <% if (submitted) { %>
    <div class="alert alert-success">Thanks for the encouragement! Hannah will love reading it.</div>
  <% } %>

  <form class="comment-form" action="/encouragement" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label for="author_name">Your Name *</label>
        <input type="text" id="author_name" name="author_name" required>
      </div>
    </div>
    <div class="form-group">
      <label for="content">Your Message *</label>
      <textarea id="content" name="content" rows="3" required placeholder="Write something encouraging..."></textarea>
    </div>
    <button type="submit" class="btn">Send Encouragement</button>
  </form>

  <% if (messages.length > 0) { %>
    <div class="encouragement-wall">
      <% messages.forEach(msg => { %>
        <div class="encouragement-card">
          <p>"<%= msg.content %>"</p>
          <span class="encouragement-author">- <%= msg.author_name %></span>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="empty-state">No messages yet — be the first!</p>
  <% } %>
</section>

<%- include('layouts/footer') %>
