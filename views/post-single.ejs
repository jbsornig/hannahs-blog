<%- include('layouts/header') %>

<article class="post-full">
  <header class="post-header">
    <span class="post-category category-<%= post.category %>"><%= post.category %></span>
    <h1><%= post.title %></h1>
    <div class="post-meta">
      <span>By <%= post.author_name %></span>
      <time><%= new Date(post.created_at).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %></time>
    </div>
  </header>

  <% if (post.featured_image) { %>
    <div class="post-featured-image">
      <img src="/uploads/<%= post.featured_image %>" alt="<%= post.title %>">
    </div>
  <% } %>

  <div class="post-content">
    <%= post.content %>
  </div>

  <div class="like-section">
    <% if (alreadyLiked) { %>
      <button id="like-btn" class="like-btn liked" disabled>
        <span class="like-heart"><%- '&#9829;' %></span>
        <span id="like-count"><%= likeCount > 0 ? likeCount : '' %></span>
      </button>
    <% } else { %>
      <button id="like-btn" class="like-btn" onclick="showLikeForm()">
        <span class="like-heart"><%- '&#9825;' %></span>
        <span id="like-count"><%= likeCount > 0 ? likeCount : '' %></span>
      </button>
      <div id="like-form" class="like-form" style="display:none;">
        <input type="text" id="like-name" placeholder="Your name (optional)" maxlength="50">
        <button class="btn btn-sm" onclick="submitLike()">Send</button>
      </div>
    <% } %>
    <% if (likeNames && likeNames.length > 0) { %>
      <p class="like-names">Liked by <%= likeNames.join(', ') %></p>
    <% } %>
  </div>

  <% if (images.length > 0) { %>
    <div class="photo-gallery">
      <h3>Photos</h3>
      <div class="gallery-grid">
        <% images.forEach(img => { %>
          <div class="gallery-item">
            <img src="/uploads/<%= img.filename %>" alt="<%= img.caption || '' %>" loading="lazy" onclick="openLightbox(this.src)">
            <% if (img.caption) { %>
              <p class="gallery-caption"><%= img.caption %></p>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (typeof videos !== 'undefined' && videos.length > 0) { %>
    <div class="video-gallery">
      <h3>Videos</h3>
      <% videos.forEach(vid => { %>
        <div class="video-item">
          <video controls preload="metadata" playsinline>
            <source src="/uploads/<%= vid.filename %>" type="video/mp4">
            Your browser does not support video playback.
          </video>
          <% if (vid.caption) { %>
            <p class="gallery-caption"><%= vid.caption %></p>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</article>

<section class="comments-section">
  <h3><%= comments.length %> Comment<%= comments.length !== 1 ? 's' : '' %></h3>

  <% comments.forEach(comment => { %>
    <div class="comment">
      <div class="comment-header">
        <strong><%= comment.author_name %></strong>
        <time><%= new Date(comment.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></time>
      </div>
      <p><%= comment.content %></p>
    </div>
  <% }) %>

  <form class="comment-form" action="/post/<%= post.slug %>/comment" method="POST">
    <h4>Leave a Comment</h4>
    <div class="form-group">
      <label for="author_name">Your Name *</label>
      <input type="text" id="author_name" name="author_name" required>
    </div>
    <div class="form-group">
      <label for="author_email">Email (optional, not displayed)</label>
      <input type="email" id="author_email" name="author_email">
    </div>
    <div class="form-group">
      <label for="content">Comment *</label>
      <textarea id="content" name="content" rows="4" required></textarea>
    </div>
    <button type="submit" class="btn">Post Comment</button>
    <p class="form-note">Comments are moderated and will appear after approval.</p>
  </form>
</section>

<!-- Lightbox -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <img id="lightbox-img" src="" alt="">
</div>

<script>
function showLikeForm() {
  document.getElementById('like-form').style.display = 'flex';
  document.getElementById('like-name').focus();
}
function submitLike() {
  const name = document.getElementById('like-name').value.trim();
  const btn = document.getElementById('like-btn');
  fetch('/post/<%= post.slug %>/like', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name })
  })
    .then(r => r.json())
    .then(data => {
      btn.classList.add('liked');
      btn.querySelector('.like-heart').innerHTML = '♥';
      btn.disabled = true;
      document.getElementById('like-count').textContent = data.count > 0 ? data.count : '';
      document.getElementById('like-form').style.display = 'none';
      if (data.names && data.names.length > 0) {
        let el = document.querySelector('.like-names');
        if (!el) {
          el = document.createElement('p');
          el.className = 'like-names';
          document.querySelector('.like-section').appendChild(el);
        }
        el.textContent = 'Liked by ' + data.names.join(', ');
      }
    });
}
document.getElementById('like-name')?.addEventListener('keydown', function(e) {
  if (e.key === 'Enter') { e.preventDefault(); submitLike(); }
});
</script>

<%- include('layouts/footer') %>
