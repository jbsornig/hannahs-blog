<%- include('../layouts/header') %>

<section class="section">
  <div class="admin-header">
    <h1>Manage Comments</h1>
    <a href="/admin" class="btn btn-outline">Back to Dashboard</a>
  </div>

  <% if (comments.length === 0) { %>
    <p class="empty-state">No comments yet.</p>
  <% } else { %>
    <div class="comments-admin-list">
      <% comments.forEach(comment => { %>
        <div class="comment-admin-card <%= comment.approved ? '' : 'comment-pending' %>">
          <div class="comment-admin-header">
            <strong><%= comment.author_name %></strong>
            <span>on "<%= comment.post_title %>"</span>
            <time><%= new Date(comment.created_at).toLocaleDateString() %></time>
            <% if (!comment.approved) { %>
              <span class="badge badge-pending">Pending</span>
            <% } %>
          </div>
          <form action="/admin/comments/<%= comment.id %>/edit" method="POST" class="comment-edit-form">
            <textarea name="content" rows="2"><%= comment.content %></textarea>
            <div class="comment-admin-actions">
              <button type="submit" class="btn btn-sm">Save</button>
              <% if (!comment.approved) { %>
                <button type="submit" formaction="/admin/comments/<%= comment.id %>/approve" class="btn btn-sm">Approve</button>
              <% } %>
              <button type="submit" formaction="/admin/comments/<%= comment.id %>/love" class="btn btn-sm <%= comment.loved ? 'btn-loved' : '' %>"><%- comment.loved ? '&#9829; Loved' : '&#9825; Love' %></button>
              <button type="submit" formaction="/admin/comments/<%= comment.id %>/delete" class="btn btn-sm btn-danger" onclick="return confirm('Delete this comment?')">Delete</button>
            </div>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../layouts/footer') %>
